#!/bin/sh /etc/rc.common
# Ada 06-Nov-2026 GPS track logger (plan §15k/§15l). procd, not Docker: the job is a small loop and
# the router has ~166 MB of RAM free. Respawn keeps it alive across modem hiccups.
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /overlay/gps/gps-log.py
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
